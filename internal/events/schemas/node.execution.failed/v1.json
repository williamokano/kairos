{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["RunID", "NodeID", "ExecID", "Reason"],
  "properties": {
    "RunID": { "type": "string", "minLength": 1 },
    "NodeID": { "type": "string", "minLength": 1 },
    "ExecID": { "type": "string", "minLength": 1 },
    "Reason": { "type": "string" },
    "Message": { "type": "string" }
  }
}
