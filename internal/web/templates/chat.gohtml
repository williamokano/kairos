{{define "chat"}}
<h1>chat</h1>
<p class="empty">Describe a task in plain text — it starts a real run, same as any other trigger.</p>

{{if .RunID}}
<section class="events" hx-ext="sse" sse-connect="/frag/run/conversation:{{.RunID}}/events">
  <div id="chat-messages" sse-swap="message" hx-get="/frag/chat/{{.RunID}}/messages" hx-trigger="sse:message" hx-target="this">
    {{template "frag/chatmessages" .Messages}}
  </div>
</section>
{{end}}

<form hx-post="/chat" hx-target="#chat-error" hx-swap="innerHTML">
  <input type="hidden" name="nonce" value="{{.FormNonce}}">
  <input type="hidden" name="continueRunId" value="{{.RunID}}">
  <input name="text" placeholder="what should it do?…" required autofocus>
  <button type="submit">send ⏎</button>
</form>
<div id="chat-error"></div>
{{end}}
