{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} · kairos</title>
<link rel="stylesheet" href="/static/app.css">
<link rel="stylesheet" href="/static/chroma.css">
<script src="/static/htmx.min.js"></script>
<script src="/static/htmx-ext-sse.js"></script>
</head>
<body hx-headers='{"Sec-Fetch-Site":"same-origin"}' data-run-id="{{.RunID}}">
<header class="topbar">
  <a href="/" class="brand">kairos</a>
  <nav>
    <a href="/runs">runs</a>
    <a href="/events">events</a>
    <a href="/findings">findings</a>
    <a href="/cost">cost</a>
    <a href="/gates">gates</a>
    <a href="/sources">sources</a>
    <a href="/runners">runners</a>
    <a href="/flows">flows</a>
    <a href="/doctor">doctor</a>
  </nav>
  <span class="kbd-hint">press <kbd>:</kbd> for the command palette</span>
</header>
<main>
{{.Body}}
</main>

<!-- The command palette (⌘K / Ctrl+K / ':') — L15-tui.md's own palette
     (internal/tui/palette.go) resolved a run id, a screen name, or a verb,
     with NO fuzzy matching and NO history (09-cli-and-tui.md's explicit
     design constraint). app.js's palette logic is a deliberate, literal
     port of resolvePalette/screenNames/paletteVerbs, not a reinterpretation
     — see L23-webui-revamp.md. -->
<div id="palette-overlay" class="palette-overlay" hidden>
  <div class="palette-box" role="dialog" aria-label="command palette">
    <input id="palette-input" type="text" autocomplete="off" spellcheck="false"
      placeholder="a run id, a page name, or a verb — enter to go, esc to cancel">
    <p class="palette-hint" id="palette-status"></p>
  </div>
</div>
<p id="kbd-status" class="kbd-status" aria-live="polite"></p>

<script src="/static/app.js"></script>
</body>
</html>
{{end}}
