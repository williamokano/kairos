{{define "sources"}}
<h1>Sources</h1>

<section class="composer">
  <h2>New cron source</h2>
  <p class="note">Cron is the only trigger-source kind that's real and constructible today —
  github/jira/linear/plugin sources have no working implementation registered in this daemon yet
  (see L29-flow-and-source-authoring.md). For anything else, use <code>kairos src add --kind
  &lt;kind&gt; --config '{"...json..."}'</code> directly.</p>
  <form hx-post="/sources/new-cron" hx-target="#source-create-result" hx-swap="innerHTML">
    <input type="hidden" name="nonce" value="{{.FormNonce}}">
    <label>id <input name="id" placeholder="nightly-backup" required autocomplete="off"></label>
    <label>flow (workflow definition path or saved flow path) <input name="flow" placeholder="/home/you/.kairos/flows/my-workflow.yaml" required autocomplete="off"></label>
    <label>schedule
      <select name="schedule" required>
        <option value="daily">daily</option>
        <option value="weekly">weekly</option>
      </select>
    </label>
    <label>weekday (0=Sunday, only for weekly) <input type="number" name="weekday" min="0" max="6" value="0"></label>
    <label>hour (0-23) <input type="number" name="hour" min="0" max="23" value="0" required></label>
    <label>minute (0-59) <input type="number" name="minute" min="0" max="59" value="0" required></label>
    <button type="submit">create cron source</button>
  </form>
  <div id="source-create-result"></div>
</section>

{{if .FetchErr}}
  <p class="error">loading sources: {{.FetchErr}}</p>
{{else if eq (len .Sources) 0}}
  <p class="empty">No trigger sources configured.</p>
{{else}}
<table>
  <thead><tr><th>id</th><th>kind</th><th>enabled</th><th>health</th><th>consecutive errors</th><th>last poll</th><th>next poll</th><th>cursor</th><th></th></tr></thead>
  <tbody>
  {{range .Sources}}
  <tr>
    <td>{{.ID}}</td>
    <td>{{.Kind}}</td>
    <td>{{if .Enabled}}yes{{else}}paused{{end}}</td>
    <td>{{.Health}}{{if .HealthReason}} ({{.HealthReason}}){{end}}</td>
    <td>{{.ConsecutiveErrors}}</td>
    <td>{{if .LastPollAt}}{{relTime .LastPollAt}}{{else}}never{{end}}</td>
    <td>{{if .NextPollAt}}{{.NextPollAt}}{{else}}—{{end}}</td>
    <td>{{if .Cursor}}{{.Cursor}}{{else}}—{{end}}</td>
    <td>
      {{if .Enabled}}
      <button type="button" data-open-dialog="pause-dialog-{{.ID}}">pause</button>
      <dialog id="pause-dialog-{{.ID}}" class="confirm-dialog">
        <form hx-post="/sources/{{.ID}}/pause" hx-target="#mutation-result-{{.ID}}" hx-swap="innerHTML" data-confirm-target="{{.ID}}">
          <h2>Pause source {{.ID}}?</h2>
          <p>Stops polling without deleting it — resume any time with <code>kairos src resume {{.ID}}</code>.</p>
          <label>type <code>{{.ID}}</code> to confirm
            <input type="text" name="confirm" pattern="{{.ID}}" autocomplete="off" required>
          </label>
          <button type="submit" data-confirm-submit disabled>pause this source</button>
          <button type="button" data-close-dialog>never mind</button>
        </form>
      </dialog>
      <span id="mutation-result-{{.ID}}"></span>
      {{end}}
    </td>
  </tr>
  {{end}}
  </tbody>
</table>
{{end}}
{{end}}
