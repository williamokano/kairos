{{define "run"}}
<h1>{{.State.ID}} <span class="pill pill-{{.State.Status}}">{{.State.Status}}</span></h1>

<section class="danger-zone">
  <button type="button" data-open-dialog="cancel-dialog">⏹ cancel</button>
  <button type="button" data-open-dialog="fork-dialog">⑃ fork</button>

  <dialog id="cancel-dialog" class="confirm-dialog">
    <form hx-post="/runs/{{.State.ID}}/cancel" hx-target="#mutation-result" hx-swap="innerHTML" data-confirm-target="{{.State.ID}}">
      <h2>Cancel {{id .State.ID}}?</h2>
      <p>Every applied effect this run has already made is compensated automatically —
      there is no partial-cancel. This cannot be undone.</p>
      <label>reason <input type="text" name="reason" required></label>
      <label>type <code>{{.State.ID}}</code> to confirm
        <input type="text" name="confirm" pattern="{{.State.ID}}" autocomplete="off" required>
      </label>
      <button type="submit" data-confirm-submit disabled>cancel this run</button>
      <button type="button" data-close-dialog>never mind</button>
    </form>
  </dialog>

  <dialog id="fork-dialog" class="confirm-dialog">
    <form hx-post="/runs/{{.State.ID}}/fork" hx-target="#mutation-result" hx-swap="innerHTML" data-confirm-target="{{.State.ID}}">
      <h2>Fork {{id .State.ID}}?</h2>
      <p>Copies the reasoning exactly; restores the workspace approximately.</p>
      <label>at sequence (0 = latest) <input type="number" name="atSequence" value="0" min="0"></label>
      <label><input type="checkbox" name="allowDrift"> allow drift (proceed without an exact workspace snapshot)</label>
      <label>type <code>{{.State.ID}}</code> to confirm
        <input type="text" name="confirm" pattern="{{.State.ID}}" autocomplete="off" required>
      </label>
      <button type="submit" data-confirm-submit disabled>fork this run</button>
      <button type="button" data-close-dialog>never mind</button>
    </form>
  </dialog>
  <div id="mutation-result"></div>
</section>

<div class="run-detail">
  <section class="timeline">
    <h2>Nodes</h2>
    <div class="table-wrap">
    <table>
      <thead><tr><th>node</th><th>exec</th><th>status</th><th>attempt</th><th>iteration</th></tr></thead>
      <tbody>
      {{range $nodeID, $execs := .State.Executions}}
        {{range $execs}}
        <tr>
          <td>{{$nodeID}}</td><td>{{id .ExecID}}</td><td><span class="pill pill-{{.Status}}">{{.Status}}</span></td><td>{{.Attempt}}</td><td>{{.Iteration}}</td>
          {{if eq .Status "waiting"}}<td><a href="/t/{{$.State.ID}}/{{$nodeID}}">decision →</a></td>{{end}}
        </tr>
        {{with index $.Outputs .ExecID}}
        <tr class="output-row">
          <td colspan="5"><details><summary>output</summary><pre class="payload">{{printf "%s" .}}</pre></details></td>
        </tr>
        {{end}}
        {{end}}
      {{end}}
      </tbody>
    </table>
    </div>
  </section>

  <section class="events" hx-ext="sse" sse-connect="/frag/run/{{.State.ID}}/events">
    <h2>Event log</h2>
    <div sse-swap="message" hx-get="/frag/run/{{.State.ID}}/timeline" hx-trigger="sse:message" hx-target="this">
      {{template "frag/timeline" .Events}}
    </div>
  </section>
</div>

<section>
  <a href="/c/{{.State.ID}}">conversation →</a>
  &middot; <a href="/runs/{{.State.ID}}/diff">diff →</a>
</section>
{{end}}
